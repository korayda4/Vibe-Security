// Test fixture — DB-002: PII without encryption

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  nationalId String   // DB-002: should be encrypted at rest
  creditCard String   // DB-002: PCI-DSS scope
  cvv        String   // DB-002: NEVER store this
  name      String?
}
